      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (action) (rate(palisade_waf_blocked_total{job=~\"$job\", app=~\"$app\"}[$__rate_interval]))",
