    {
      "id": 17,
      "type": "timeseries",
      "title": "Request latency",
      "description": "WAF inspection plus the backend round trip.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(palisade_http_request_duration_seconds_bucket{job=~\"$job\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(palisade_http_request_duration_seconds_bucket{job=~\"$job\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(palisade_http_request_duration_seconds_bucket{job=~\"$job\", app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
