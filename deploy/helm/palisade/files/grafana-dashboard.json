    {
      "id": 20,
      "type": "timeseries",
      "title": "Verdict cache hit ratio",
      "description": "WAF checks answered from the 5s verdict cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(palisade_waf_verdict_cache_hits_total{job=~\"$job\"}[$__rate_interval])) / (sum(rate(palisade_waf_verdict_cache_hits_total{job=~\"$job\"}[$__rate_interval])) + sum(rate(palisade_waf_verdict_cache_misses_total{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
